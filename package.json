{
  "name": "somnob-pos-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.5.1",
  "description": "Enterprise-grade multi-branch retail POS ecosystem",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "npm --workspace=@somnob/backend run db:generate",
    "db:migrate": "npm --workspace=@somnob/backend run db:migrate",
    "db:seed": "npm --workspace=@somnob/backend run db:seed",
    "db:studio": "npm --workspace=@somnob/backend run db:studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
