# ==========================================
# Somnob POS - Environment Configuration
# ==========================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=somnob_pos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/somnob_pos?schema=public

# Redis Cache & Sessions
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend API
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
JWT_ACCESS_SECRET=somnob_super_secret_jwt_access_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=somnob_super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Currency & Exchange
DEFAULT_BASE_CURRENCY=USD
DEFAULT_OPERATIONAL_CURRENCY=KHR
DEFAULT_USD_KHR_EXCHANGE_RATE=4100.0000

# Client URLs (CORS)
ADMIN_APP_URL=http://localhost:3000
POS_APP_URL=http://localhost:3001
CUSTOMER_APP_URL=http://localhost:3002
